# Database Configuration (PostgreSQL with PostGIS in production, SQLite in development)
DATABASE_URL=postgresql://geomeasure:geomeasure_secret@localhost:5432/geomeasure
# For SQLite local fallback:
# DATABASE_URL=sqlite:///./geomeasure.db

# Platform Settings
ENVIRONMENT=development
DEBUG=false
LOG_LEVEL=INFO

# Security & Uploads
MAX_UPLOAD_SIZE_MB=50
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Server Binding
PORT=8000
